generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model File {
  id           String  @id() @default(uuid())
  folderId     String
  folder       Folder  @relation(fields: [folderId], references: [id])
  name         String
  mimetype     String
  cryptdata    Bytes?
}

model Folder {
  id           String  @id() @default(uuid())
  retention    Int
  autodestruct Boolean
  files        File[]
}
